    <modelVersion>4.0.0</modelVersion>

    <groupId>com.flower</groupId>
    <artifactId>flower</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Flower</name>
    <description>花卉销售管理系统 - 父工程</description>

    <modules>
